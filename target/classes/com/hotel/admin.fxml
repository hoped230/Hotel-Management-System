<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="12"
    styleClass="admin-root"
    prefWidth="780"
    prefHeight="560"
>

    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

    <!-- Top Bar — HBox -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Admin Panel" styleClass="title-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button
            fx:id="adminLogoutBtn"
            text="Logout"
            styleClass="secondary-btn"
        />
    </HBox>

    <!-- Filter Bar — HBox + ComboBox -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Filter:" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="filterCombo" />
    </HBox>

    <!-- Room Table — TableView -->
    <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Room #" prefWidth="80" />
            <TableColumn text="Type" prefWidth="100" />
            <TableColumn text="Status" prefWidth="100" />
            <TableColumn text="Guest Name" prefWidth="160" />
            <TableColumn text="Phone" prefWidth="140" />
        </columns>
    </TableView>

    <!-- Add Room + Checkout Forms — GridPane -->
    <GridPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <!-- Add Room -->
        <Label
            text="Add Room:"
            style="-fx-font-weight: bold;"
            GridPane.rowIndex="0"
            GridPane.columnIndex="0"
        />
        <TextField
            fx:id="newRoomNumber"
            promptText="Room Number"
            prefWidth="120"
            GridPane.rowIndex="0"
            GridPane.columnIndex="1"
        />
        <ComboBox
            fx:id="roomTypeCombo"
            promptText="Room Type"
            prefWidth="130"
            GridPane.rowIndex="0"
            GridPane.columnIndex="2"
        />
        <Button
            fx:id="addRoomBtn"
            text="Add Room"
            styleClass="success-btn"
            GridPane.rowIndex="0"
            GridPane.columnIndex="3"
        />

        <!-- Checkout -->
        <Label
            text="Checkout:"
            style="-fx-font-weight: bold;"
            GridPane.rowIndex="1"
            GridPane.columnIndex="0"
        />
        <TextField
            fx:id="checkoutRoomNumber"
            promptText="Room Number"
            prefWidth="120"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1"
        />
        <Button
            fx:id="adminCheckoutBtn"
            text="Checkout"
            styleClass="danger-btn"
            GridPane.rowIndex="1"
            GridPane.columnIndex="2"
        />
    </GridPane>

</VBox>
